<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cast Your Vote - Spectrum 4 Voting System</title>
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%
    // Colour the buttons by meaning rather than by position. Options are
    // free-form, so styling the 1st/2nd/3rd button green/red/grey painted
    // "No" green whenever a motion listed No first.
    const yesTones = ['yes', 'y', 'approve', 'approved', 'for', 'agree', 'in favour', 'in favor', 'support'];
    const noTones  = ['no', 'n', 'reject', 'rejected', 'against', 'oppose', 'disagree'];
    const abstainTones = ['abstain', 'abstention', 'neutral', 'no vote'];

    function choiceTone(option) {
      const key = String(option).trim().toLowerCase();
      if (yesTones.includes(key)) return 'yes';
      if (noTones.includes(key)) return 'no';
      if (abstainTones.includes(key)) return 'abstain';
      return 'neutral';
    }
  %>

  <header class="vote-header">
    <div class="vote-header-inner">Spectrum 4 Council Vote</div>
  </header>

  <div class="vote-main">
    <div class="vote-card card">
      <% if (error) { %>
        <div class="alert alert-error">
          <%= error %>
        </div>
      <% } else if (motion && token) { %>
        <div class="motion-info">
          <h2><%= motion.title %></h2>
          <% if (motion.description) { %>
            <p class="description"><%= motion.description %></p>
          <% } %>
          <div class="meta">
            <strong>Voting closes:</strong> <%= new Date(motion.close_at).toLocaleString() %>
          </div>
        </div>

        <div class="vote-form">
          <h3>Select your vote</h3>

          <!--
            Without JavaScript the buttons below would do nothing and the voter
            would be stuck, so this block supplies real submit buttons. The
            scripted UI is hidden at the same time.
          -->
          <noscript>
            <style>#jsVoteUI { display: none !important; }</style>
            <div class="alert alert-info" style="margin-bottom: 1rem;">
              JavaScript is disabled in your browser. Choose an option and press
              &#8220;Cast Vote&#8221; to submit it &mdash; there will be no extra
              confirmation step.
            </div>
            <form method="POST" action="/vote/<%= motion.id %>" class="vote-form-inner">
              <input type="hidden" name="token" value="<%= token.token %>">
              <div class="vote-options">
                <% motion.options.forEach(option => { %>
                  <button type="submit"
                          name="choice"
                          value="<%= option %>"
                          class="vote-button vote-button--<%= choiceTone(option) %>">
                    <%= option %>
                  </button>
                <% }) %>
              </div>
            </form>
          </noscript>

          <div id="jsVoteUI">
            <!-- Confirmation overlay (hidden by default) -->
            <div id="confirmOverlay"
                 role="alertdialog"
                 aria-modal="true"
                 aria-labelledby="confirmHeading"
                 aria-describedby="confirmHelp"
                 tabindex="-1"
                 style="display:none; margin-bottom: 1rem;">
              <div class="alert alert-info" style="margin-bottom: 0.75rem;">
                <span id="confirmHeading">You are about to vote: <strong id="confirmChoice"></strong>.</span><br>
                <small id="confirmHelp">This action cannot be undone &mdash; your token will be used.</small>
              </div>
              <div style="display: flex; gap: 0.5rem;">
                <button type="button" id="confirmBtn" class="btn btn-primary" style="flex:1;">Confirm Vote</button>
                <button type="button" id="cancelBtn" class="btn btn-secondary" style="flex:1;">Cancel</button>
              </div>
            </div>

            <form method="POST" action="/vote/<%= motion.id %>" class="vote-form-inner" id="voteForm">
              <input type="hidden" name="token" value="<%= token.token %>">
              <input type="hidden" name="choice" id="choiceInput" value="">

              <div class="vote-options" id="voteOptions">
                <% motion.options.forEach(option => { %>
                  <button type="button"
                          class="vote-button vote-button--<%= choiceTone(option) %>"
                          data-choice="<%= option %>">
                    <%= option %>
                  </button>
                <% }) %>
              </div>
            </form>
          </div>
        </div>

        <p class="privacy-note">
          &#128274; Your vote is anonymous and recorded securely. This link can only be used once.
        </p>
      <% } %>
    </div>
  </div>

  <script src="/vote.js"></script>
</body>
</html>
