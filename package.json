{
  "name": "strata-vote",
  "version": "1.0.0",
  "description": "Production-ready strata council voting system with one-time links",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "test": "bash smoke-test.sh",
    "docker:build": "docker build -t stratavote .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "backup": "bash scripts/backup.sh"
  },
  "keywords": [
    "voting",
    "strata",
    "council"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "cookie": "^1.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "better-sqlite3-session-store": "^0.1.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.17.3",
    "helmet": "^7.2.0",
    "imapflow": "^1.7.8",
    "joi": "^17.13.8",
    "mailparser": "^3.9.36",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "winston": "^3.19.0"
  }
}
