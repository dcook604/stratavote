# Required
# Minimum 12 characters; the app logs a warning below that.
ADMIN_PASSWORD=CHANGE_ME_min_20_chars
SESSION_SECRET=GENERATE_WITH_openssl_rand_base64_32

# Optional
# BASE_URL is the public origin used to build voting links. Set it in
# production: it is also the only source for the HTTPS redirect, so a wrong
# value breaks that redirect rather than trusting a client-supplied Host header.
BASE_URL=http://localhost:3300
PORT=3300
NODE_ENV=development
LOG_LEVEL=info

# Security (optional)
IP_HASH_SALT=GENERATE_WITH_openssl_rand_hex_32

# Timezone (optional)
# IANA zone name used to interpret the wall-clock times entered in the motion
# forms and CSV imports. DST-aware.
APP_TIMEZONE=America/Vancouver
# Legacy fixed offset in minutes (e.g. -480 for PST). Only used when
# APP_TIMEZONE is unset. Ignored if both are set.
# APP_TIMEZONE_OFFSET_MINUTES=-480

# Email Configuration (optional - if not set, voting links must be manually copied)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# SMTP_PASS is accepted as an alias for SMTP_PASSWORD (used only if the latter
# is unset).
# SMTP_PASS=
SMTP_FROM_NAME=Strata Council
SMTP_FROM_EMAIL=noreply@yourdomain.com
# Overrides the From: header entirely (e.g. "Strata Council <noreply@x.com>").
# SMTP_FROM=
# Set to false to stop the background worker sending results emails.
RESULTS_EMAILS_ENABLED=true

# Email-created motions (optional)
# The poller reads unseen mail in IMAP_USER's inbox and creates a motion for
# each message. It refuses to poll at all while IMAP_AUTHORIZED_SENDERS is
# empty, so nothing can create a motion by emailing the inbox until at least
# one sender is listed. Messages are left unread until then.
# IMAP_AUTHORIZED_SENDERS=manager@example.com,president@example.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# ssl (default) or starttls
IMAP_SECURITY=ssl
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_POLL_INTERVAL_MS=60000
# Close time given to a motion created from an email, in hours from arrival.
IMAP_DEFAULT_DEADLINE_HOURS=48

# WhatsApp notifications (optional - requires a running OpenWA instance)
OPENWA_URL=http://localhost:8000
OPENWA_SESSION_ID=your-session-id
OPENWA_API_KEY=your-api-key
